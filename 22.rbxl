					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">PlateScript</string>
					<string name="Source">local plate = script.Parent&#13;&#10;&#13;&#10;local color = plate.BrickColor&#13;&#10;&#13;&#10;&#13;&#10;function disappear()&#13;&#10;&#9;plate.BrickColor = BrickColor.new(26)&#13;&#10;&#9;wait(.5)&#13;&#10;&#9;for i=1,5 do&#13;&#10;&#9;&#9;plate.Transparency = (i / 5)&#13;&#10;&#9;&#9;wait(.2)&#13;&#10;&#9;end&#13;&#10;&#9;plate.CanCollide = false&#13;&#10;&#9;&#13;&#10;&#9;wait(5)&#13;&#10;&#13;&#10;&#9;plate.CanCollide = true&#13;&#10;&#9;plate.Transparency = 0&#13;&#10;&#9;plate.BrickColor = color&#13;&#10;end&#13;&#10;&#13;&#10;&#13;&#10;while true do&#13;&#10;&#9;if (math.random(1,10) == 5) then disappear() end&#13;&#10;&#9;wait(2)&#13;&#10;end</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
		</Item>
