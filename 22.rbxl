				<string name="Source">local s = Instance.new(&quot;Sound&quot;)&#13;&#10;&#13;&#10;s.Name = &quot;BGMusic&quot;&#13;&#10;s.SoundId = &quot;http://www.roblox.com/asset/?version=1&amp;id=1015394&quot;&#13;&#10;s.Volume = 1&#13;&#10;s.Looped = true&#13;&#10;s.archivable = false&#13;&#10;&#13;&#10;s.Parent = game.Workspace&#13;&#10;&#13;&#10;wait(5)&#13;&#10;&#13;&#10;s:play()</string>
